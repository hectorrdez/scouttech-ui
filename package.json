      "types": "./dist/DropdownFloating.d.ts",
      "default": "./dist/DropdownFloating.js"
    },
    "./PublicHeader": {
      "types": "./dist/PublicHeader.d.ts",
      "default": "./dist/PublicHeader.js"
    },
    "./PublicFooter": {
      "types": "./dist/PublicFooter.d.ts",
      "default": "./dist/PublicFooter.js"
    },
    "./LegalLayout": {
      "types": "./dist/LegalLayout.d.ts",
      "default": "./dist/LegalLayout.js"
    },
    "./scouttechUrl": {
      "types": "./dist/scouttechUrl.d.ts",
      "default": "./dist/scouttechUrl.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts --host --force",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.41.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
