{
  "name": "scouttech-ui",
  "version": "0.1.0",
  "description": "Shared design tokens and React controls for the ScoutTech apps",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "files": [
    "dist",
    "tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Button": {
      "types": "./dist/Button.d.ts",
      "default": "./dist/Button.js"
    },
    "./ButtonLink": {
      "types": "./dist/ButtonLink.d.ts",
      "default": "./dist/ButtonLink.js"
    },
    "./ButtonToogle": {
      "types": "./dist/ButtonToogle.d.ts",
      "default": "./dist/ButtonToogle.js"
    },
    "./Input": {
      "types": "./dist/Input.d.ts",
      "default": "./dist/Input.js"
    },
    "./Select": {
      "types": "./dist/Select.d.ts",
      "default": "./dist/Select.js"
    },
    "./ThemeToggle": {
      "types": "./dist/ThemeToggle.d.ts",
      "default": "./dist/ThemeToggle.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.41.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
