      "default": "./dist/NoLicensePage.js"
    },
    "./EmptyState": {
      "types": "./dist/EmptyState.d.ts",
      "default": "./dist/EmptyState.js"
    },
    "./Tabs": {
      "types": "./dist/Tabs.d.ts",
      "default": "./dist/Tabs.js"
    },
    "./Table": {
      "types": "./dist/Table.d.ts",
      "default": "./dist/Table.js"
    },
    "./FileInput": {
      "types": "./dist/FileInput.d.ts",
      "default": "./dist/FileInput.js"
