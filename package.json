      "types": "./dist/Modal.d.ts",
      "default": "./dist/Modal.js"
    },
    "./Aside": {
      "types": "./dist/Aside.d.ts",
      "default": "./dist/Aside.js"
    },
    "./Badge": {
      "types": "./dist/Badge.d.ts",
      "default": "./dist/Badge.js"
