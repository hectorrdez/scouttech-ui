{
  "name": "scouttech-ui",
  "version": "0.12.0",
  "description": "Shared design tokens and React controls for the ScoutTech apps",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "files": [
    "dist",
    "tokens.css",
    "themes",
    "brand"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Button": {
      "types": "./dist/Button.d.ts",
      "default": "./dist/Button.js"
    },
    "./ButtonLink": {
      "types": "./dist/ButtonLink.d.ts",
      "default": "./dist/ButtonLink.js"
    },
    "./ButtonToogle": {
      "types": "./dist/ButtonToogle.d.ts",
      "default": "./dist/ButtonToogle.js"
    },
    "./Card": {
      "types": "./dist/Card.d.ts",
      "default": "./dist/Card.js"
    },
    "./StatCard": {
      "types": "./dist/StatCard.d.ts",
      "default": "./dist/StatCard.js"
    },
    "./CookieConsent": {
      "types": "./dist/CookieConsent.d.ts",
      "default": "./dist/CookieConsent.js"
    },
    "./Input": {
      "types": "./dist/Input.d.ts",
      "default": "./dist/Input.js"
    },
    "./Select": {
      "types": "./dist/Select.d.ts",
      "default": "./dist/Select.js"
    },
    "./Textarea": {
      "types": "./dist/Textarea.d.ts",
      "default": "./dist/Textarea.js"
    },
    "./Checkbox": {
      "types": "./dist/Checkbox.d.ts",
      "default": "./dist/Checkbox.js"
    },
    "./Radio": {
      "types": "./dist/Radio.d.ts",
      "default": "./dist/Radio.js"
    },
    "./Field": {
      "types": "./dist/Field.d.ts",
      "default": "./dist/Field.js"
    },
    "./ThemeToggle": {
      "types": "./dist/ThemeToggle.d.ts",
      "default": "./dist/ThemeToggle.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./ProductMark": {
      "types": "./dist/ProductMark.d.ts",
      "default": "./dist/ProductMark.js"
    },
    "./AuthBrandHeader": {
      "types": "./dist/AuthBrandHeader.d.ts",
      "default": "./dist/AuthBrandHeader.js"
